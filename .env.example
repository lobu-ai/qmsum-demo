# LLM providers — at least one of these must be set.
# Used by both the Lobu agent (provider config in lobu.toml) and by promptfoo's
# default rubric grader (anthropic:messages:claude-haiku-4-5-20251001).
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Postgres with pgvector. `lobu run` will create the schema on first boot.
# Example: postgres://postgres:postgres@localhost:5432/qmsum_demo
DATABASE_URL=

# 32-byte hex secret used by Lobu to encrypt connector credentials at rest.
# Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=

# Gateway the promptfoo provider talks to. Default for `lobu run` is :8787;
# remember the agent API is mounted under /lobu.
LOBU_GATEWAY=http://localhost:8787

# Bearer token for the Lobu Agent API. From `lobu token` after `lobu login`,
# or a PAT minted in the admin UI. Required by promptfoo.
LOBU_TOKEN=

# Agent id the promptfoo provider drives. Matches [agents.<id>] in lobu.toml.
LOBU_AGENT=qmsum
